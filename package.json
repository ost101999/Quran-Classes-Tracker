{
  "name": "quran-classes-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "main": "desktop-app/main.js",
  "scripts": {
    "postinstall": "npm --prefix desktop-app install",
    "dev": "npm --prefix desktop-app run dev --",
    "preview": "npm --prefix desktop-app run preview --",
    "start": "npm --prefix desktop-app run start --",
    "build": "npm --prefix desktop-app run build --",
    "version:current": "node build-with-version.cjs --print-version",
    "electron:build": "npm run build && node build-with-version.cjs --publish never"
  }
}
